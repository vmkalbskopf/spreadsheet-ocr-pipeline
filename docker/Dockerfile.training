# Training image: CUDA + PyTorch + QLoRA/AWQ stack.
# GPU-only -- requires nvidia-container-toolkit on the host and `--gpus all`
# at run time. No LibreOffice/X11 dependencies here at all.

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
# See Dockerfile.screenshot-gen for why this matters: without it, progress
# output (training loss, prepare_dataset/export_awq/teds_eval prints) sits
# buffered and invisible in `docker logs` / Dagster's log capture until the
# process exits, since docker run's stdout is a pipe, not a terminal.
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY docker/requirements-training.txt .
RUN pip3 install --no-cache-dir -r requirements-training.txt

COPY src/training/ ./src/training/
COPY src/eval/ ./src/eval/
COPY config/ ./config/

# Data, manifests, and checkpoints are bind-mounted at runtime:
#   -v $(pwd)/data:/app/data -v $(pwd)/checkpoints:/app/checkpoints
# Default entrypoint runs training; override for prepare_dataset.py /
# export_awq.py / teds_eval.py as needed. In the Dagster orchestration
# layer (orchestration/dagster/resources.py) this override is done via
# `docker run --entrypoint ...`, one call per script -- see DockerRunner
# .run_training(entrypoint_override=...).
ENTRYPOINT ["python3", "src/training/train_qlora.py"]
CMD ["--config", "config/train_qlora.yaml"]
