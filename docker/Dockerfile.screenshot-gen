# Screenshot generation image: LibreOffice + Xvfb + capture tooling.
# CPU-only, no CUDA -- deliberately kept separate from the training image
# so this stays small and its dependency set (UNO, X11 tooling) never
# leaks into the GPU training environment.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-calc \
    libreoffice-script-provider-python \
    python3 python3-pip python3-uno \
    xvfb xdotool wmctrl imagemagick \
    fonts-liberation fonts-crosextra-carlito \
    && rm -rf /var/lib/apt/lists/*

# ImageMagick's default policy blocks PNG/window capture in some distros --
# relax it explicitly rather than debugging a silent capture failure later.
RUN sed -i 's/rights="none" pattern="PS"/rights="read|write" pattern="PS"/' \
    /etc/ImageMagick-6/policy.xml 2>/dev/null || true

WORKDIR /app
COPY requirements-screenshot-gen.txt .
RUN pip3 install --break-system-packages --no-cache-dir -r requirements-screenshot-gen.txt

COPY src/screenshot_generation/ ./src/screenshot_generation/
COPY config/ ./config/

# Data and outputs are bind-mounted at runtime, not baked in:
#   -v $(pwd)/data:/app/data
ENTRYPOINT ["python3", "src/screenshot_generation/generate_dataset.py"]
